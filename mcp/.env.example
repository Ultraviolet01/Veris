# ─────────────────────────────────────────────────────────────────────────────
# Veris MCP Server — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Monad Testnet RPC URL (Chain ID 10143)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Deployed Veris smart contract addresses on Monad Testnet (Chain ID 10143)
# These are optional — leave blank to use the live defaults already built into config.ts
ACP_CORE_ADDRESS=0x5898d78653C1f691431A045580c1b1D6aFC28AF9
SLA_EVALUATOR_ADDRESS=0xfc10869E2Bb2E8060DD59C59D0aAB01475bb75A0
SELLER_REGISTRY_ADDRESS=0xE0E71C31890DD9f78b3B7f147046dBF1cc374547
REPUTATION_REGISTRY_ADDRESS=0x4b4c76a28a0f5577A80a470C64d64c4dFC5A7183
PAYMENT_TOKEN_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# Buyer private key for executing on-chain purchase transactions (approve + createJob + fund).
# Optional for read-only tools (list_datasets, get_quote, verify_delivery, check_reputation).
BUYER_PRIVATE_KEY=

# Polling parameters for waiting on operator resolution
POLL_TIMEOUT_MS=30000
POLL_INTERVAL_MS=1500
