# Veris Operator — Environment Variables
# Copy this file to .env and fill in all values before running.
# ────────────────────────────────────────────────────────────────────────────
# A second, independent operator can run their own instance by filling in
# their own values here with NO code changes. This proves the marketplace is real.

# ── Monad Testnet (chain 10143) — where ACPCore/escrow/payment live ─────────
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# ── Monad Mainnet (chain 143) — where Kuru/Perpl data lives ─────────────────
# HyperRPC provides a fast RPC endpoint backed by Envio's HyperSync.
# Generate your API token at: https://envio.dev/app/api-tokens
# URL pattern: https://143.rpc.hypersync.xyz/<api-token>
MONAD_MAINNET_RPC_URL=https://mainnet-rpc.monad.xyz
HYPERRPC_URL=https://143.rpc.hypersync.xyz/<YOUR_ENVIO_API_TOKEN>

# ── Operator identity ────────────────────────────────────────────────────────
# This key signs attestations. Its address must match operatorKey in SellerRegistry.
# Never share or commit this value. Never hardcoded.
OPERATOR_PRIVATE_KEY=<0x...your_private_key>

# ── Deployed contract addresses (from deployments/monad-testnet.json) ────────
ACP_CORE_ADDRESS=
SLA_EVALUATOR_ADDRESS=
SELLER_REGISTRY_ADDRESS=
VERIS_TREASURY_ADDRESS=

# ── Payment token ────────────────────────────────────────────────────────────
# USDC on Monad testnet (6 decimals — NOT 18-decimal wei)
PAYMENT_TOKEN_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# ── Seller identity ──────────────────────────────────────────────────────────
# The bytes32 sellerId this operator instance serves.
# Must match the sellerId registered in SellerRegistry.registerSeller().
# Example: 0x$(cast keccak "kuru.monad.pool.mon-usdc" | cut -c 3-)
SELLER_ID=<0x...bytes32_seller_id>

# ── Data source config (dataset-specific) ────────────────────────────────────
# For Kuru: the market contract address on Monad mainnet (chain 143)
# Find the MON/USDC market address at https://kuru.io or Monadscan.
# Multiple markets can be added as a comma-separated list in the future.
KURU_MARKET_ADDRESS=<0x...kuru_market_address_on_monad_mainnet>

# ── Polling interval ─────────────────────────────────────────────────────────
# How often to poll for new funded jobs (milliseconds).
# Monad produces blocks ~1 per second, so 2000ms = check every ~2 blocks.
POLL_INTERVAL_MS=2000

# ── Job expiry window ────────────────────────────────────────────────────────
# How far in the future to set expiredAt when creating jobs (seconds).
# The operator service uses this when triggered by the frontend.
JOB_EXPIRY_SECONDS=3600
